# MongoDB. Local development without Docker: `pnpm db:local` runs one on port 27018.
# With Docker instead: docker run -d -p 27017:27017 --name lab-mongo mongo:7  (and use port 27017 below)
MONGODB_URI=mongodb://127.0.0.1:27018/lab_partner

# 32 random bytes, base64. Encrypts webhook secrets and TOTP secrets at rest. Never change it once
# data exists: the stored secrets could no longer be read.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Name of the session cookie.
SESSION_COOKIE_NAME=lp_session

# Bearer token the scheduler sends to /api/jobs/deliveries (GET or POST) every minute; that run
# retries result deliveries that failed. Generate like APP_ENCRYPTION_KEY.
CRON_SECRET=

# Public URL of this app. Goes into the API endpoint shown to MyClinicSoft and the report check links.
APP_URL=http://localhost:3000
