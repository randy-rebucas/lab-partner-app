{
  "name": "lab-partner-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "seed": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed.ts",
    "db:indexes": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/db-indexes.ts",
    "mock:clinic": "tsx --env-file-if-exists=.env.local scripts/mock-clinic/server.ts",
    "mock:order": "tsx --env-file-if-exists=.env.local scripts/mock-clinic/send-order.ts",
    "db:local": "node scripts/db-local.mjs",
    "e2e:sign-in": "tsx e2e/sign-in.ts",
    "e2e:fixtures": "tsx --env-file-if-exists=.env.local --conditions=react-server e2e/fixtures.ts",
    "e2e:shell": "tsx e2e/shell.ts",
    "e2e:admin-users": "tsx e2e/admin-users.ts",
    "e2e:clinics": "tsx e2e/clinics.ts",
    "e2e:catalog": "tsx e2e/catalog.ts",
    "e2e:intake": "tsx e2e/intake.ts",
    "e2e:inbox": "tsx e2e/inbox.ts",
    "e2e:specimens": "tsx e2e/specimens.ts",
    "privacy:export": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/privacy-export.ts",
    "privacy:delete": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/privacy-delete.ts",
    "e2e:full": "tsx e2e/full-flow.ts",
    "create-user": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/create-user.ts",
    "e2e:setup": "tsx e2e/setup.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.563.0",
    "mongoose": "^8.24.9",
    "next": "16.4.1",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "mongodb-memory-server": "^10.2.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
